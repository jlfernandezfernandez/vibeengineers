# Copia a .env y rellena. Nunca commitear .env.

# --- Postgres ---
POSTGRES_USER=ctx
POSTGRES_PASSWORD=ctx
POSTGRES_DB=ctx
# Desde el backend (dentro de compose el host es `postgres`)
DATABASE_URL=postgresql://ctx:ctx@postgres:5432/ctx

# --- Garage (S3) ---
# Generar con: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
# Salen de `garage key create` (ver comentario en docker-compose.yml)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ctx

# --- Auth (GitHub OAuth App "ctx-dev" con callback a localhost) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Firma de la cookie de sesión. Generar con: openssl rand -hex 32
SESSION_SECRET=
# Username de GitHub del admin inicial
ADMIN_GITHUB_USERNAME=jlfernandezfernandez

# --- LLM ---
OPENROUTER_API_KEY=
# Modelo barato en dev
OPENROUTER_MODEL=
OLLAMA_CLOUD_API_KEY=

# --- Emails (Resend; en dev los emails van a consola) ---
RESEND_API_KEY=

# --- Frontend ---
# URL de la API vista desde el navegador
PUBLIC_API_URL=http://localhost:8000
# Origen permitido en CORS del backend
FRONTEND_ORIGIN=http://localhost:4321
